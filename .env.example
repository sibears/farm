# Copy to .env and set real values before running docker-compose.full.yml.
# .env is gitignored — never commit real secrets.

# Grafana admin password (replaces Grafana's default admin/admin).
GRAFANA_ADMIN_PASSWORD=change_me_admin

# Read-only Postgres password used by Grafana's PostgreSQL datasource.
# Must match what the postgres init script creates for the grafana_ro role.
GRAFANA_RO_PASSWORD=change_me_ro
